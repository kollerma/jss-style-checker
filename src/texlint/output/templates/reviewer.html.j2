<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>jss-lint compliance — {{ report.journal_id }}</title>
<style>
  body { font-family: -apple-system, Segoe UI, Roboto, sans-serif; margin: 2rem; color: #222; }
  h1 { margin-top: 0; }
  table { border-collapse: collapse; width: 100%; margin-top: 0.5rem; }
  th, td { border: 1px solid #ddd; padding: 0.5rem 0.75rem; font-size: 0.95rem; }
  th { background: #f5f5f5; text-align: left; }
  .num { text-align: right; font-variant-numeric: tabular-nums; }
  .status-PASS { color: #2a7a2a; font-weight: 600; }
  .status-FAIL { color: #b00020; font-weight: 600; }
  .status-SKIPPED { color: #777; font-weight: 600; }
  .overall { font-size: 1.6rem; margin-top: 1rem; }
  .overall.none { color: #777; }
</style>
</head>
<body>
<h1>Journal compliance — {{ report.journal_id }}</h1>
<p>Tool version: <code>{{ report.tool_version }}</code></p>
<table>
  <thead>
    <tr><th>Category</th><th>Status</th><th class="num">Applied</th><th class="num">Passed</th><th>Recall</th></tr>
  </thead>
  <tbody>
  {% for c in report.categories %}
    <tr>
      <td>{{ c.title }}</td>
      <td class="status-{{ c.status.value }}">{{ c.status.value }}</td>
      <td class="num">{{ c.rules_applied }}</td>
      <td class="num">{{ c.rules_passed }}</td>
      <td>{% if c.recall %}{{ c.recall.label(min_plants) }}{% else %}n/a{% endif %}</td>
    </tr>
  {% endfor %}
  </tbody>
</table>
{% if report.compliance_percentage is none %}
<p class="overall none">Overall: n/a</p>
{% else %}
<p class="overall">Overall: <strong>{{ report.compliance_percentage }}%</strong></p>
{% endif %}
{%- if measured_recall %}
<p class="note">{{ measured_recall }}</p>
{%- endif %}
{%- if coverage_counts %}
<h2>Not checked by jss-lint</h2>
{%- if coverage_gaps %}
<table class="coverage">
  <thead>
    <tr><th>Directive</th><th>Status</th><th>Provision</th></tr>
  </thead>
  <tbody>
  {% for d in coverage_gaps %}
    <tr>
      <td>{{ d.id }}</td>
      <td>{% if d.status == "partial" %}partial{% else %}not checked{% endif %}</td>
      <td>{{ d.provision }}</td>
    </tr>
  {% endfor %}
  </tbody>
</table>
{%- endif %}
<p class="note">{{ coverage_counts }}</p>
{%- endif %}
{%- if report.baseline %}
<p class="note">Baseline: {{ report.baseline.matched }} findings hidden by {{ report.baseline.path }} ({{ report.baseline.stale }} stale, {{ report.baseline.unevaluated }} unevaluated){% if report.baseline.ruleset_version and report.rule_set.version and report.baseline.ruleset_version != report.rule_set.version %} — written for rule set {{ report.baseline.ruleset_version }}, current {{ report.rule_set.version }}; run --update-baseline{% endif %}</p>
{%- endif %}
</body>
</html>
